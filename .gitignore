# Только каталоги в корне проекта: шаблон без ведущего «/» игнорировал бы любой
# одноимённый каталог на любой глубине — так `data/` однажды съел
# `backend/text_normalization/data/` со словарём восстановления «ё».
/venv/
/models/
/voices/
/output/
# База проектов: рабочее состояние пользователя, а не часть проекта.
/data/
# Логи лаунчера VOICE_SYNTEZ.command: машинный журнал запуска, не часть проекта.
/logs/
__pycache__/
*.py[cod]
.DS_Store
*.log
.voice_syntez.lock
.voice_syntez.pid
# Артефакт оболочки, к проекту не относится.
:memory:.ses
# Результаты benchmark'а LLM: сырые ответы моделей и метрики конкретного прогона —
# артефакт запуска, а не часть проекта. Baseline хранится отдельно и явно.
/benchmarks/russian_linguistics/results/
